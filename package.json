{
  "name": "obsidian-muesli",
  "version": "0.1.2",
  "description": "The AI notepad for back-to-back meetings, in Obsidian. Notes, actions and memory in your vault, without a meeting bot.",
  "main": "main.js",
  "scripts": {
    "dev": "bun esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && bun esbuild.config.mjs production",
    "check": "tsc -noEmit -skipLibCheck && bun test tests",
    "test": "bun test tests"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Azilone/obsidian-muesli.git"
  },
  "homepage": "https://github.com/Azilone/obsidian-muesli#readme",
  "bugs": "https://github.com/Azilone/obsidian-muesli/issues",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.11.0",
    "builtin-modules": "^3.3.0",
    "esbuild": "^0.21.5",
    "obsidian": "latest",
    "tslib": "^2.6.2",
    "typescript": "^5.4.5"
  },
  "dependencies": {
    "@breezystack/lamejs": "^1.2.7"
  }
}
